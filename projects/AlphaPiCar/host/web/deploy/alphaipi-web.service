[Unit]
Description=AlphaPi Car Web Remote
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/Codes/AlphaPiCar
ExecStart=/usr/bin/python3 /home/pi/Codes/AlphaPiCar/car_web.py --port 8080
Restart=always
RestartSec=3
# 监听小车心跳需绑定 UDP 1000（<1024 为特权端口），授予最小权限
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
